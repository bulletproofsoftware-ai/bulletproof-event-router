# ==== event-router core ====
EVENTS_DIR=./config.example
DLQ_PATH=./data/dead-letter-queue.sqlite
# n8n base for webhook dispatch targets
N8N_BASE_URL=http://localhost:5678

# Dead-letter queue behaviour (values below are the built-in defaults)
DLQ_RETENTION_DAYS=30
DLQ_MAX_RETRIES=3
DLQ_RETRY_INTERVAL_SECONDS=60
DLQ_BACKOFF_MS_BASE=2000

# Dispatch timing (values below are the built-in defaults)
WEBHOOK_TIMEOUT_SECONDS=10
ROUTING_RELOAD_SECONDS=30
DELAYED_DISPATCH_POLL_SECONDS=30

# Fallback directory for routing rules whose consumer sets no target_directory.
# Blank = those consumers are skipped.
CONDUCTOR_STATE_DIR=

# ==== runtime bridge (all OPTIONAL — unset = that mirror is skipped) ====
EVENT_ROUTER_DB=./data/dead-letter-queue.sqlite
EVENT_ROUTER_BASE_URL=http://localhost:8085
BRIDGE_STATE=./data/bridge-state.json
BRIDGE_POLL_SEC=5

# Downstream: runtime-security session/threat mirror (leave blank to disable)
RUNTIME_SECURITY_URL=

# Downstream: data-plane lineage Postgres (full DSN; blank to disable)
# e.g. host=localhost port=5432 user=USER password=PASS dbname=data_plane
DATA_PLANE_DSN=

# Downstream: agent-economics cost mirror (blank to disable)
ECONOMICS_DSN=
ECONOMICS_BASE_URL=http://localhost:8096

# Downstream: metrics-engine sqlite backfill (blank to disable)
METRICS_SQLITE_PATH=

# n8n workflow-health sync (blank API key = health sync disabled)
N8N_API_KEY=
N8N_SYNC_INTERVAL_SEC=60
WORKFLOW_REGISTRY_PATH=./config.example/workflow-registry.yaml

# HMAC secret for the workflow_health POST endpoint (blank to disable auth)
WORKFLOW_HEALTH_HMAC_SECRET=

# Optional notification script path, invoked on heartbeat failure (blank to disable)
NOTIFY_SCRIPT=
# Consecutive failed heartbeats before NOTIFY_SCRIPT fires
HEARTBEAT_FAIL_THRESHOLD=3

# Downstream: agent-economics session-presence mirror (both blank = disabled)
ECONOMICS_EVENTS_URL=
ECONOMICS_TOKEN_PATH=

# ==== n8n-health-poller (runtime/n8n-health-poller.py, run on a schedule) ====
# Reads N8N_API_KEY and WORKFLOW_HEALTH_HMAC_SECRET from the environment.
# Set POLLER_ENV_FILE only if your scheduler cannot inject env vars; it points
# at a KEY=VALUE file holding those two secrets. Blank = read from environment.
POLLER_ENV_FILE=
POLLER_REGISTRY=./config.example/workflow-registry.yaml
POLLER_N8N_BASE_URL=http://localhost:5678
POLLER_EVENT_ROUTER_URL=http://127.0.0.1:8085
